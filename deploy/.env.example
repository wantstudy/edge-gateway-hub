# =============================================================================
# iot-daq 网关 · 部署环境变量样例（task 60）
# =============================================================================
# 用法：
#   cp deploy/.env.example deploy/.env
#   # 按现场实际情况填写后，docker compose --env-file deploy/.env -f deploy/docker/docker-compose.yml up -d
#
# 权威设计文档：
#   docs/design/container-deploy.md            （运行参数 / 设备接入 / 离线流程）
#   docs/design/container-machine-binding.md   （宿主指纹锚点，陷阱 1）
#   docs/design/container-persistence-layout.md（持久卷布局，陷阱 2）
#   docs/design/container-supply-chain.md      （镜像签名与 digest pin）
#
# ⚠️ 本文件**不得**放入任何真实密钥 / 口令。所有示例值均为明显占位（REPLACE_ME）。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 镜像引用（红线：必须 digest pin，禁止可变 tag / latest）
# -----------------------------------------------------------------------------
# 由 CI 打包阶段注入，见 container-supply-chain.md §6。
# 人工不得改这一行；改 digest 视为一次受审变更。
# 格式：<registry>/<repo>@sha256:<64位十六进制>
# 校验方式：见 deploy/scripts/sign-and-verify.sh
#
# ⚠️ 下方值**不是**可用的 digest，而是「未填写」的显式占位（REPLACE_ME）。
#   现场部署前必须替换为 CI 出具的真实 manifest digest（64 位十六进制），
#   否则 compose / 校验脚本会因引用非法而被拒绝（fail-closed）。
#   切勿保留全零 / 占位值上线。
IOT_DAQ_IMAGE=iot-daq/iot-daq-gateway@sha256:REPLACE_WITH_CI_MANIFEST_DIGEST_64HEX

# 供应链验签公钥路径（安装介质随包分发，勿与安装包同渠道，见 supply-chain §4.1）
IOT_DAQ_COSIGN_PUBKEY=/opt/iot-daq/offline/cosign/iot-daq-supply.pub

# 发布记录中的 git-sha，用于 cosign verify 的 -a 断言（供应链 §4.3）
IOT_DAQ_RELEASE_GIT_SHA=REPLACE_ME_GIT_SHA

# -----------------------------------------------------------------------------
# 2. 容器名称与运行时
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=iot-daq
IOT_DAQ_CONTAINER_NAME=iot-daq-gateway
IOT_DAQ_TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# 3. 宿主指纹锚点（陷阱 1 的第一道防线）
# -----------------------------------------------------------------------------
# 以上均为**宿主机**路径，容器内以只读方式挂载到 /host/... 前缀下。
# 严禁改成本容器内的路径（容器内 machine-id 每次 docker rm 都会变）。
IOT_DAQ_HOST_MACHINE_ID=/etc/machine-id
IOT_DAQ_HOST_DMI_DIR=/sys/class/dmi/id

# 宿主持久卷根目录（陷阱 2：授权/试用/租约/队列/配置/日志全部落这里）
# 严禁在 compose 中删除该挂载 —— 否则 docker rm && docker run 即成为重置试用的绕过路径。
IOT_DAQ_DATA_DIR=/var/lib/iot-daq

# 宿主持久卷属主（服务账户）。安装脚本会 chown/chmod 该目录。
# 建议用专用系统账户（如 iotdaq），不要用 root、不要用登录账户。
IOT_DAQ_DATA_OWNER_UID=990
IOT_DAQ_DATA_OWNER_GID=990

# -----------------------------------------------------------------------------
# 4. 宿主 MAC 指纹文件（安装脚本采集写入，只读挂载进容器）
# -----------------------------------------------------------------------------
# 由 deploy/scripts/install.sh 采集宿主首个物理网卡 MAC 并写入。
# 内容形如：{"host_mac":"...","collected_at":"...","hostname":"...","sig":"..."}（HMAC 签名）
IOT_DAQ_FINGERPRINT_FILE=/var/lib/iot-daq/host-fingerprint.json

# 容器内经环境变量注入的宿主 MAC（daemon 的 EnvAnchor 读取，见 machine_id.rs EnvAnchor）。
IOT_DAQ_HOST_MAC=REPLACE_ME_FROM_INSTALL_SCRIPT

# -----------------------------------------------------------------------------
# 5. 授权 / 许可服务
# -----------------------------------------------------------------------------
# 云端授权服务基址（离线现场可留空，daemon 走本地租约宽限期逻辑）
# canonical 形态 = http://license.webscad.cn/licensing（不带端口；宿主 nginx 收到
#   /licensing/* 后**剥掉前缀**转发到授权服务根路径，例如
#   http://license.webscad.cn/licensing/activate → http://127.0.0.1:9010/activate）。
# ★ 已接线：覆盖 [gateway.licensing].cloud_url；容器只读根文件系统下这是唯一注入通道。
IOT_DAQ_LICENSE_SERVER_URL=http://license.webscad.cn/licensing
# ★ 已接线：单位【秒】；覆盖 [gateway.licensing].heartbeat_interval_secs。
# 非法值（0 / 非数字）记 warn 并回退配置文件值（见 installer-hardening §9 的本地 max_seen 兜底）。
IOT_DAQ_LEASE_HEARTBEAT_SECS=300
# 注：离线宽限期旋钮是 [gateway.licensing].grace_days（单位【天】），**无秒级同名键**；
#     daemon 侧不存在 IOT_DAQ_LEASE_GRACE_SECS 消费者，故不在此声明（保留即误导）。

# ---- 系统更新（OTA）：容器形态启用 OTA 的唯一通道 ----
# 容器内 /etc/iot-daq/gateway.toml 只读且该目录未挂载卷 → 运行期无法改 [gateway.ota]，
# 故必须经下列 env 注入（见 config.rs::apply_env_overrides）。
# ★ IOT_DAQ_OTA_ENABLED：true/1/yes/on 启用；false/0/no/off 或留空 = 不启用（默认）。
IOT_DAQ_OTA_ENABLED=false
# ★ IOT_DAQ_OTA_SIGNING_KEY_B64：授权端 Ed25519 签名公钥（标准 base64）；启用时必填。
IOT_DAQ_OTA_SIGNING_KEY_B64=
# ★ IOT_DAQ_OTA_MANIFEST_URL：**留空时按 IOT_DAQ_LICENSE_SERVER_URL 推导**
#   （{cloud_url}/updates/manifest）；如需显式指定则填 canonical manifest URL。
IOT_DAQ_OTA_MANIFEST_URL=http://license.webscad.cn/licensing/updates/manifest
# ★ IOT_DAQ_OTA_CURRENT_VERSION：网关当前 OTA 版本号（u64 单调序，缺省 0）。
IOT_DAQ_OTA_CURRENT_VERSION=0

# 指纹 HMAC 盐（厂商私密常量）。**绝不可**写入镜像层或提交到 git。
# 生产形态由 KMS 托管；本地/现场由安装器交互式注入到权限为 0600 的 secret 文件。
# 示例值仅为占位，长度不足会直接导致启动校验失败（见 entrypoint.sh）。
IOT_DAQ_FINGERPRINT_KEY_FILE=/run/secrets/iot-daq-fingerprint-key

# -----------------------------------------------------------------------------
# 6. 网络（host 网络模式，见 container-deploy.md §2.2）
# -----------------------------------------------------------------------------
# host 网络下容器与宿主共享协议栈（Modbus TCP 广播发现 / UDP 组播必需）。
# 管理面监听端口；建议仅绑定内网网卡 + 宿主防火墙放行，勿在 compose 内改绑。
IOT_DAQ_HTTP_BIND=0.0.0.0
IOT_DAQ_HTTP_PORT=8080
# Gateway 容器内置前端目录（daemon 直接 serve /index.html 和 /assets/*）
IOT_DAQ_WEB_DIST=/srv/web-console
# 南向协议端口（示例：Modbus TCP 从站/主站侧）；按现场实际填写
IOT_DAQ_MODBUS_TCP_PORT=502

# -----------------------------------------------------------------------------
# 7. 串口设备接入（见 container-deploy.md §2.1）
# -----------------------------------------------------------------------------
# 声明几个开几个；未插线的设备节点会导致容器启动失败。
# 现场换口（ttyUSB 编号漂移）建议改用稳定路径 /dev/serial/by-id/...。
# 先跑 deploy/scripts/detect-serial.sh 生成建议配置。
IOT_DAQ_SERIAL_DEVICES=/dev/ttyUSB0
IOT_DAQ_SERIAL_GROUP=dialout

# -----------------------------------------------------------------------------
# 8. 资源限制与日志（见 container-deploy.md §2.3 / §2.4）
# -----------------------------------------------------------------------------
IOT_DAQ_MEM_LIMIT=512m
IOT_DAQ_CPUS=1.0
IOT_DAQ_LOG_MAX_SIZE=20m
IOT_DAQ_LOG_MAX_FILE=5

# -----------------------------------------------------------------------------
# 9. 日志级别与运行时行为
# -----------------------------------------------------------------------------
# trace | debug | info | warn | error
IOT_DAQ_LOG_LEVEL=info
# 是否输出 JSON 结构化日志（对接宿主日志采集时打开）
IOT_DAQ_LOG_JSON=false
# 注：运行时自检发现篡改当前恒按 restricted 处理；策略可配尚未实现，
#     不存在 IOT_DAQ_TAMPER_POLICY 消费者，故不在此声明（保留即误导）。

# -----------------------------------------------------------------------------
# 10. 健康检查参数
# -----------------------------------------------------------------------------
IOT_DAQ_HEALTHCHECK_INTERVAL=30s
IOT_DAQ_HEALTHCHECK_TIMEOUT=5s
IOT_DAQ_HEALTHCHECK_RETRIES=3
IOT_DAQ_HEALTHCHECK_START_PERIOD=20s

# -----------------------------------------------------------------------------
# 11. 离线现场专用（无外网）
# -----------------------------------------------------------------------------
# 离线包解包目录（install.sh / verify.sh 使用）
IOT_DAQ_OFFLINE_BUNDLE_DIR=/opt/iot-daq/offline
# ★ 仅影响**安装期**（install.sh：跳过 registry 登录 / 在线验签 / 时间同步）；
#   **运行时无消费者**（daemon / 容器运行环境均不读取本变量）。
IOT_DAQ_OFFLINE_MODE=1
# 若现场无 cosign 二进制，置 1 走降级路径（仅哈希 + load + 人工核对 digest），
# 会打印醒目警告并记入安装单残余风险；**不推荐**。
IOT_DAQ_ALLOW_VERIFY_DEGRADE=0
