# =============================================================================
# iot-daq 网关容器内置 nginx 配置【模板】
# =============================================================================
# 本文件是模板，不是可直接使用的 nginx 配置：
#   启动脚本 start.sh 用 envsubst 把下列占位符渲染后写到可写路径（/tmp/nginx.conf）
#   再交给 nginx 加载。原因：容器以 read_only 根文件系统运行，/etc/nginx 不可写。
#
# 渲染的占位符（两个，缺一不可）：
#   ${IOT_DAQ_WEB_PORT}   —— nginx 对外监听端口（用户访问入口，默认 8080）
#   ${IOT_DAQ_HTTP_PORT}  —— daemon 管理面监听端口（反代目标，必须与 daemon 实际端口一致）
#
# ★ 端口联动红线：反代目标必须与 daemon 实际监听端口同源（同一个
#   IOT_DAQ_HTTP_PORT）。历史上曾出现 nginx 写死 8081 而 daemon 由 env 监听
#   9011 的错配，表现为「页面能开、所有 API 502」。此处用同一个变量渲染即为固化修复。
#
# SSE 红线（/api/stream、/api/events 是长连接，绝不可当普通 JSON 轮询）：
#   proxy_buffering 必须 off，否则 nginx 缓冲会吞掉流式响应。
# =============================================================================

worker_processes auto;

# ★ 运行身份必须与容器运行 uid 一致（compose 的 user: 65532）。
#   容器 cap_drop: ALL，无 CAP_SETUID —— 若此处写 nginx(101) 或 root(0)，
#   master 切换身份会失败，nginx 直接退出（表现为容器起来但 Web 全不可达）。
user 65532;

error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # WebSocket / SSE 升级头归一化（$connection_upgrade 供下方 proxy_set_header 使用）
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    log_format main '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    open_file_cache max=1000 inactive=20s;
    open_file_cache_valid 60s;
    open_file_cache_min_uses 2;
    open_file_cache_errors on;

    server {
        listen ${IOT_DAQ_WEB_PORT};
        server_name _;

        # ---- 静态资源根目录（随镜像分发的前端产物）----
        root /srv/web-console;
        index index.html;

        location /assets/ {
            try_files $uri =404;
            expires 30d;
            add_header Cache-Control "public, max-age=2592000, immutable";
            add_header X-Content-Type-Options nosniff;
        }

        location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            try_files $uri =404;
            expires 7d;
            add_header Cache-Control "public, max-age=604800";
            add_header X-Content-Type-Options nosniff;
        }

        # ---- SPA 路由：非静态资源一律回落到 index.html ----
        location / {
            try_files $uri $uri/ /index.html;
        }

        # ---- API 反代 —— 目标端口与 daemon 同源（见文件头红线）----
        location /api/ {
            proxy_pass http://127.0.0.1:${IOT_DAQ_HTTP_PORT};
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Authorization $http_authorization;
            # SSE 需要 Upgrade/Connection 透传（长连接，不是普通请求）
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            # SSE 长连接：读超时放长，且必须关闭缓冲
            proxy_read_timeout 3600s;
            proxy_buffering off;
            proxy_cache off;
            chunked_transfer_encoding on;

            add_header X-Accel-Buffering no;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";
            add_header Expires "0";
        }

        # ---- SSE 显式端点：语义与 /api/ 一致，单独声明以防被通用规则覆盖 ----
        location = /api/stream {
            proxy_pass http://127.0.0.1:${IOT_DAQ_HTTP_PORT};
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Authorization $http_authorization;
            proxy_read_timeout 3600s;
            proxy_buffering off;
            proxy_cache off;
            add_header X-Accel-Buffering no;
        }

        location = /api/events {
            proxy_pass http://127.0.0.1:${IOT_DAQ_HTTP_PORT};
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Authorization $http_authorization;
            proxy_read_timeout 3600s;
            proxy_buffering off;
            proxy_cache off;
            add_header X-Accel-Buffering no;
        }

        # ---- 健康检查（容器 healthcheck 探针用）----
        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "OK\n";
        }

        # ---- 禁止访问隐藏文件 ----
        location ~ /\. {
            deny all;
            return 404;
        }
    }
}
