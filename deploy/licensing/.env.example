# =============================================================================
# iot-daq 授权端（licensing-server）环境变量示例
# =============================================================================
# 复制为同目录下的 `.env` 后填入真实值（`.env` 已被 .gitignore 忽略，严禁入库）。
#   cp .env.example .env && ${EDITOR:-vi} .env
# ⚠️ 本文件**只含占位符，绝不含真实密钥**。
# =============================================================================

# ---- 管理员凭据 ----
# 初始管理员用户名（缺省 admin）
IOTDAQ_ADMIN_USER=admin

# 生产推荐：管理员口令的 SHA-256 摘要（**恰好 64 位小写 hex**）
#   生成： printf '%s' '<你的口令>' | sha256sum | cut -d' ' -f1
IOTDAQ_ADMIN_PASSWORD_SHA256=<64-hex-sha256-of-admin-password>

# 明文兜底（二选一；本地/容器引导用，不推荐生产）：
#   与 IOTDAQ_ADMIN_PASSWORD_SHA256 同时存在时，**摘要优先**
# IOTDAQ_ADMIN_PASSWORD=<plaintext-admin-password>

# ---- 管理端 JWT 签名密钥 ----
# 任意非空字符串（服务端 SHA-256 归一为 32 字节）；缺省时回退内置 dev 密钥并 warn
#   生成： openssl rand -hex 32
IOTDAQ_JWT_SECRET=<random-long-secret>

# ---- Lease Token 签名私钥（b64 Ed25519，32 / 64 字节）----
# 两者**必须成对**提供；缺省时签发端点 fail-closed（验签路径不受影响）
# IOT_DAQ_LICENSE_SIGNING_KID=<kid-string>
# IOT_DAQ_LICENSE_SIGNING_KEY=<base64-ed25519-secret-key>

# ---- 可选：宿主数据目录（默认 /opt/iot-daq/licensing/data）----
# 该目录须 chown 65532:65532（容器非 root）
# IOTDAQ_DATA_DIR=/opt/iot-daq/licensing/data
