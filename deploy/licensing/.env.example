# =============================================================================
# iot-daq 授权端（licensing-server）· 单机部署环境变量模板
# =============================================================================
# ⛔ 安全红线：**绝不可**把真实密钥 / 口令 / 摘要写入本文件，更不允许提交 git。
#    本文件只放**占位符**；现场在服务器上复制为 `.env` 后填真值，并收紧权限：
#        cp .env.example .env && chmod 600 .env
#    （线上路径 `/opt/iot-daq/licensing/.env`，属主 root、权限 0600、不入库。）
#
# 键集合与 `deploy/licensing/docker-compose.yml` 的 `environment:` 引用**逐一对应**，
# 亦与线上 `.env` 的键集合一致。各键缺省后果见注释。
# =============================================================================

# ---- 管理员凭据（fail-closed：_SHA256 缺失 → 登录全拒）----
# 初始管理员用户名；缺省 admin。
IOTDAQ_ADMIN_USER=admin

# 管理员口令的 **SHA-256 摘要（恰好 64 位小写 hex，非明文）**。
#   生成：printf '%s' '<你的口令>' | sha256sum | cut -d' ' -f1
#   缺省/留空 → 零账号，`/admin/auth/login` 全部 401（fail-closed，绝不放行默认弱口令）。
IOTDAQ_ADMIN_PASSWORD_SHA256=<64-hex-sha256-of-admin-password>

# 明文兜底（可选；本地 / 容器引导用，**生产不用**）：
#   与 _SHA256 同时存在时**摘要优先**；线上未启用本键。
# IOTDAQ_ADMIN_PASSWORD=<plaintext-admin-password>

# ---- 管理端 JWT 签名密钥 ----
# 任意非空字符串（服务端 SHA-256 归一为 32 字节）；缺省 → 回退内置 dev 密钥并 warn（生产必配）。
#   生成：openssl rand -hex 32
IOTDAQ_JWT_SECRET=<random-long-secret>

# ---- Lease Token 签名私钥（**两者必须成对**；缺任一 → 签发端点 fail-closed）----
# KID：密钥标识（随 Lease Token 下发给网关，用于选公钥验签）。
IOT_DAQ_LICENSE_SIGNING_KID=<kid-string>
# KEY：Ed25519 私钥 base64（32 字节种子）。该私钥**同时用于给 OTA 升级包签名**，
#      网关侧需配对**同一密钥对**的对应公钥（`[gateway.ota].signing_key_b64` /
#      env `IOT_DAQ_OTA_SIGNING_KEY_B64`）。
IOT_DAQ_LICENSE_SIGNING_KEY=<base64-ed25519-secret-key>

# ---- 持久卷 ----
# 宿主持久卷根目录（容器内挂到 /data）。须先创建并 `chown -R 65532:65532`
#   （容器以非 root uid/gid 65532 运行，read_only 根文件系统）。
IOTDAQ_DATA_DIR=/opt/iot-daq/licensing/data

# ---- 监听 / 探针端口（容器部署统一 9010）----
# 容器内监听地址；缺省 0.0.0.0:9010。代码内 DEFAULT_LISTEN_ADDR 的 7080 仅本地直跑默认值。
IOT_DAQ_LISTEN_ADDR=0.0.0.0:9010
# healthprobe 探针端口（**须与监听端口一致**）；同时决定宿主回环端口映射
#   （compose `127.0.0.1:${IOT_DAQ_HTTP_PORT}:${IOT_DAQ_HTTP_PORT}`）。
IOT_DAQ_HTTP_PORT=9010
