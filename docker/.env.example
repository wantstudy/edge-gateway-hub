# IoT-DAQ 网关 · 环境变量（复制为 .env 后按需修改；全部有默认值）
# -----------------------------------------------------------------------------

# 镜像引用（可选自定义）
# 注意：本仓 docker/docker-compose.yml 内联硬编码了镜像引用 wantstudy/iot-daq-gateway:latest，
# 并不读取本变量，因此常规部署无需改动这里。
# 本变量仅用于需要自定义镜像的场景，例如离线导入 tar.gz 后用本地 tag 覆盖：
#   docker load < iot-daq-gateway-<版本>-linux-amd64.tar.gz
#   IOT_DAQ_IMAGE=wantstudy/iot-daq-gateway:<版本号>   # 离线导入后的本地 tag
# 升级时整包替换，勿混用版本。
IOT_DAQ_IMAGE=wantstudy/iot-daq-gateway:latest

IOT_DAQ_CONTAINER_NAME=iot-daq-gateway

# 唯一持久根（授权/试用/租约/队列/配置/日志）——路径须持久、属主 65532:65532
IOT_DAQ_DATA_DIR=/opt/iot-daq/gateway/data

# 指纹 HMAC 盐文件路径（首次安装生成一次，之后禁止改动内容）
IOT_DAQ_FINGERPRINT_KEY_FILE=/opt/iot-daq/gateway/secrets/iot-daq-fingerprint-key

# 授权服务基址（厂商托管；换域名只改这里，其余不动）
IOT_DAQ_LICENSE_SERVER_URL=http://license.webscad.cn/licensing

# 端口（IoT-DAQ 专用段，避开 8080 与其他厂商用段）
# 29105 = 管理 API，29205 = Web 控制台。
# 任一端口被宿主进程占用时会自动 +1 顺延，上限 IOT_DAQ_PORT_PROBES 个；
# 顺延后的实际端口写入容器内 /run/iot-daq-ports.env（healthcheck 会自动读取）。
IOT_DAQ_HTTP_PORT=29105
IOT_DAQ_WEB_PORT=29205
IOT_DAQ_PORT_PROBES=10
IOT_DAQ_HTTP_BIND=0.0.0.0

# 资源上限
IOT_DAQ_MEM_LIMIT=512m
IOT_DAQ_CPUS=1.0

# 宿主 MAC（留空 = 容器自动从宿主锚点推导；多网卡现场可显式指定业务网卡 MAC）
IOT_DAQ_HOST_MAC=

# 日志级别：info / debug / warn
IOT_DAQ_LOG_LEVEL=info

# ---- 串口采集（需同时取消 docker-compose.yml 中 devices/group_add 注释）----
# IOT_DAQ_SERIAL_DEVICES=/dev/ttyUSB0
