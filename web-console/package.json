{
  "name": "iot-daq-web-console",
  "version": "1.0.0",
  "private": true,
  "description": "IoT-DAQ 客户端网关控制台（网关本机浏览器访问：接入 / 点位 / 转发 / 监控 / 授权 / 运维）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.56.3",
    "@iot-daq/ui-kit": "file:../ui-kit",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
